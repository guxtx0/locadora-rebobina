            "titleColor": {
              "solid": {
                "color": "#AEB4C0"
              }
            }
          }
        ],
        "categoryAxis": [
          {
            "labelColor": {
              "solid": {
                "color": "#AEB4C0"
              }
            },
            "titleColor": {
              "solid": {
                "color": "#AEB4C0"
              }
            }
          }
        ],
        "legend": [
