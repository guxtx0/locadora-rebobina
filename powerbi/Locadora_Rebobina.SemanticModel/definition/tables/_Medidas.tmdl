	measure 'Clientes em Risco Alto' = CALCULATE ( COUNTROWS ( dim_cliente ), dim_cliente[faixa_risco] = "1. Alto" )
		formatString: #,0
		displayFolder: 9. Modelos (Python)
		lineageTag: 5224b4b8-a1f4-5a20-865b-f68184c1b73c

	/// Gasto dos últimos 180 dias ponderado pela probabilidade de abandono.
	measure 'Receita em Risco (Abandono)' = SUM ( dim_cliente[receita_em_risco_180d] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 9. Modelos (Python)
		lineageTag: 444ed7d6-10cb-518e-bde8-1bcb173bbd1b

	measure 'Importância do Fator' = SUM ( importancia_churn[importancia] )
		formatString: 0.000
