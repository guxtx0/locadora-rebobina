		lineageTag: 3ed0735c-db8a-52f3-ace3-6fa29606ea5e

	measure 'Faturamento (Top 10 bairros)' = IF ( RANKX ( ALLSELECTED ( dim_cliente[bairro_cidade] ), [Faturamento],, DESC ) <= 10, [Faturamento] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 6. Rankings
		lineageTag: 9428691d-46a4-58c7-a6ea-d91a6724792b

	measure 'Faturamento (Top 10 clientes)' = IF ( RANKX ( ALLSELECTED ( dim_cliente ), [Faturamento],, DESC ) <= 10, [Faturamento] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 6. Rankings
