	measure 'Cópias Ideais' = SUM ( otimizacao_copias[copias_ideais] )
		formatString: #,0
		displayFolder: 9. Modelos (Python)
		lineageTag: edaf7ce6-4212-5ce4-a48e-f6ec28ab9b4b

	/// Lucro adicional na fase de lançamento se cada filme tivesse o número ideal de cópias em cada loja.
	measure 'Ganho com Cópias Ideais' = SUM ( otimizacao_copias[ganho_liquido] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
