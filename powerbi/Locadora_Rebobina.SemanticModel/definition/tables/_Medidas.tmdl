	/// Faturamento apenas para os 15 filmes que mais faturaram no filtro atual.
	measure 'Faturamento (Top 15 filmes)' = IF ( RANKX ( ALLSELECTED ( dim_filme ), [Faturamento],, DESC ) <= 15, [Faturamento] )
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		displayFolder: 6. Rankings
		lineageTag: 4a976cdf-aa4a-50b7-a5d2-6e6a37abdf5b

	measure 'Locações (Top 15 filmes)' = IF ( RANKX ( ALLSELECTED ( dim_filme ), [Faturamento],, DESC ) <= 15, [Locações] )
		formatString: #,0
		displayFolder: 6. Rankings
		lineageTag: 392095f5-90b2-50a3-9674-3e412608aaf0

	measure 'Locações (Top 10 atores)' = IF ( RANKX ( ALLSELECTED ( dim_ator[ator] ), [Locações],, DESC ) <= 10, [Locações] )
		formatString: #,0
