/// Atores (5 primeiros créditos de cada filme).
table dim_ator
	lineageTag: b767ae27-4fe7-54bd-89a2-b427ea747ce3

	column id_ator
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2c7fb374-3735-537c-baaf-654b5ded9d19
		summarizeBy: none
		sourceColumn: id_ator

		annotation SummarizationSetBy = Automatic

	column ator
		dataType: string
		lineageTag: 2a787b68-7440-56fe-b08e-e698760a7f57
		summarizeBy: none
		sourceColumn: ator

		annotation SummarizationSetBy = Automatic

	partition dim_ator = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_ator", Int64.Type}, {"ator", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
