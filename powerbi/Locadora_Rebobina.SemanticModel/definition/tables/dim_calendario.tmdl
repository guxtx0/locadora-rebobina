	partition dim_calendario = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"Data", type date}, {"Ano", Int64.Type}, {"Mês Nº", Int64.Type}, {"Mês", type text}, {"Ano-Mês Nº", Int64.Type}, {"Mês/Ano", type text}, {"Trimestre", type text}, {"Trimestre Nº", Int64.Type}, {"Dia da Semana", type text}, {"Dia da Semana Nº", Int64.Type}, {"Feriado", type text}, {"Tipo de Dia", type text}, {"Tipo de Dia Nº", Int64.Type}, {"Período Escolar", type text}, {"Data Comemorativa", type text}, {"Jogo do Brasil na Copa", type text}, {"Mês Índice", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
