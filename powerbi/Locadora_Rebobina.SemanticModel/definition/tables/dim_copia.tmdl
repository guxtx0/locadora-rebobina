/// Cópias físicas (DVD e Blu-ray) de cada filme em cada loja. Base da taxa de ocupação do estoque.
table dim_copia
	lineageTag: 94a79102-e949-5dd2-9557-0ebb97a3d1e2

	column id_copia
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 34960aa7-4fd7-54cd-a3b1-1b54fab64eb8
		summarizeBy: none
		sourceColumn: id_copia

		annotation SummarizationSetBy = Automatic

	column id_filme
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: ff705402-f4b2-5c5a-b2bd-1dd6d7b16836
		summarizeBy: none
		sourceColumn: id_filme

		annotation SummarizationSetBy = Automatic

	column id_loja
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 27000af8-1a98-57b0-8344-12c098106b12
		summarizeBy: none
		sourceColumn: id_loja

		annotation SummarizationSetBy = Automatic

	column midia
		dataType: string
		lineageTag: ff47aa83-4e50-5386-9524-e6dbe3286e07
		summarizeBy: none
		sourceColumn: midia

		annotation SummarizationSetBy = Automatic

	column data_aquisicao
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: f7b2696d-8f65-53ef-9683-ebfc3187a19f
		summarizeBy: none
		sourceColumn: data_aquisicao

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column custo_aquisicao
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 44037583-fdca-5c6f-a5d2-e2cd32822130
		summarizeBy: none
		sourceColumn: custo_aquisicao

		annotation SummarizationSetBy = Automatic

	partition dim_copia = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_copia", Int64.Type}, {"id_filme", Int64.Type}, {"id_loja", Int64.Type}, {"midia", type text}, {"data_aquisicao", type date}, {"custo_aquisicao", Currency.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
