	partition dim_filme = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_filme", Int64.Type}, {"filme", type text}, {"titulo_original", type text}, {"titulo_ingles", type text}, {"categoria", type text}, {"idioma", type text}, {"classificacao", type text}, {"duracao_min", Int64.Type}, {"faixa_duracao", type text}, {"data_lancamento", type date}, {"ano_lancamento", Int64.Type}, {"decada", type text}, {"data_chegada_locadora", type date}, {"perfil_titulo", type text}, {"sucesso_bilheteria", type text}, {"diretor", type text}, {"bilheteria_rs", Currency.Type}, {"orcamento_rs", Currency.Type}, {"faixa_bilheteria", type text}, {"nota_media", type number}, {"tema", type text}, {"tipo_preco_atual", type text}, {"preco_locacao", Currency.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
