	partition dim_loja = m
		mode: import
		source =
				let
				    Partes = {
				        "TY9BDoJADEX3nGIO0EkGCTFuAROWBg9ACtOQGqDJMLhw5R28oSdxQFE3/c1v8/I/27qXC8I6GmTnBFq2aAk6cjR6Aoseax5x7maHLUoUQ0WNNMFSuYweOxrU8/5Qx96KQyvwXbYzlNRTeC8YJ9gZk2iT6thEux8pK1fGGa84TQybZtSLKsXxTZYslTTkvKhTyMYOF1aqzUGbOEr+WOT5HSkPDUKjj6w+FExdIPAQzJWw1yFQnEYv"
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_loja", Int64.Type}, {"loja", type text}, {"bairro", type text}, {"cidade", type text}, {"gerente", type text}, {"data_inauguracao", type date}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
