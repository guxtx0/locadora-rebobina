/// Tentativas de locação sem cópia livre na loja: demanda perdida por falta de estoque.
table fato_demanda_nao_atendida
	lineageTag: 0753eba8-7e78-5034-84e7-530e07e6d660

	column data
		dataType: dateTime
		formatString: dd/mm/yyyy
		lineageTag: 384fd3bc-81cc-5153-b941-3cacb7d36908
		summarizeBy: none
		sourceColumn: data

		annotation UnderlyingDateTimeDataType = Date

		annotation SummarizationSetBy = Automatic

	column id_loja
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 683889a7-369d-57fe-b7aa-863e99cda4ed
		summarizeBy: none
		sourceColumn: id_loja

		annotation SummarizationSetBy = Automatic

	column id_filme
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5bc02b2e-9230-5006-86d6-cdcbaa0ce394
		summarizeBy: none
		sourceColumn: id_filme

		annotation SummarizationSetBy = Automatic

	column id_cliente
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 09df34ef-67e8-5129-bc3e-f2ab559b703b
		summarizeBy: none
		sourceColumn: id_cliente

		annotation SummarizationSetBy = Automatic

	column valor_estimado
		dataType: decimal
		formatString: "R$"\ #,0.00;-"R$"\ #,0.00;"R$"\ #,0.00
		lineageTag: 8e4f7984-3ef4-5489-843f-927c81da6657
		summarizeBy: none
		sourceColumn: valor_estimado

		annotation SummarizationSetBy = Automatic

	partition fato_demanda_nao_atendida = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"data", type date}, {"id_loja", Int64.Type}, {"id_filme", Int64.Type}, {"id_cliente", Int64.Type}, {"valor_estimado", Currency.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
