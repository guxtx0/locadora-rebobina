	partition fato_pagamento = m
		mode: import
		source =
				let
				    Partes = {
				        "",
				        "",
				        "",
				        "",
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_pagamento", Int64.Type}, {"data_pagamento", type date}, {"id_cliente", Int64.Type}, {"id_loja", Int64.Type}, {"id_filme", Int64.Type}, {"tipo_pagamento", type text}, {"forma_pagamento", type text}, {"valor", Currency.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
