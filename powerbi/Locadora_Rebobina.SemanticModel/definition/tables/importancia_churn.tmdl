/// Python: peso de cada fator no modelo de risco de abandono (importância por permutação).
table importancia_churn
	lineageTag: 21209505-9ffa-5074-897d-9f96669ac6e1

	column fator
		dataType: string
		lineageTag: 09e3fd87-9c29-56c7-8eb1-71d2057edcb2
		summarizeBy: none
		sourceColumn: fator

		annotation SummarizationSetBy = Automatic

	column importancia
		dataType: double
		formatString: 0.000
		lineageTag: 352667aa-ae1c-5e1c-b9da-48c4e77173d1
		summarizeBy: none
		sourceColumn: importancia

		annotation SummarizationSetBy = Automatic

	partition importancia_churn = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"fator", type text}, {"importancia", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
