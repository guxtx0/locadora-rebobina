/// Python: métricas de validação dos modelos.
table metricas_modelos
	lineageTag: ff779e4b-ffcd-5b4f-b046-ed053ded0a71

	column modelo
		dataType: string
		lineageTag: 3ef868c9-e533-5e9a-81ae-ec8bfc7d2e2b
		summarizeBy: none
		sourceColumn: modelo

		annotation SummarizationSetBy = Automatic

	column metrica
		dataType: string
		lineageTag: cbea516b-e030-510b-a357-0f48ebfe7398
		summarizeBy: none
		sourceColumn: metrica

		annotation SummarizationSetBy = Automatic

	column valor
		dataType: double
		formatString: #,0.0
		lineageTag: d8a71bce-5c24-5374-931e-1f5404488f12
		summarizeBy: none
		sourceColumn: valor

		annotation SummarizationSetBy = Automatic

	column texto
		dataType: string
		lineageTag: 31ded1c8-c82b-5f41-8da3-b91a94c55f19
		summarizeBy: none
		sourceColumn: texto

		annotation SummarizationSetBy = Automatic

	column ordem
		dataType: int64
		formatString: 0
		lineageTag: 29a511da-c9d5-5ac9-b335-1615b11e9f1e
		summarizeBy: none
		sourceColumn: ordem

		annotation SummarizationSetBy = Automatic

	partition metricas_modelos = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"modelo", type text}, {"metrica", type text}, {"valor", type number}, {"texto", type text}, {"ordem", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
