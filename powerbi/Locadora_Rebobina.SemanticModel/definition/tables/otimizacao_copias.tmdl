	partition otimizacao_copias = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_filme", Int64.Type}, {"id_loja", Int64.Type}, {"copias_atuais", Int64.Type}, {"copias_ideais", Int64.Type}, {"demanda_180d", type number}, {"locacoes_atendiveis_atual", type number}, {"receita_perdida_atual", Currency.Type}, {"ganho_liquido", Currency.Type}, {"custo_liquido_copia", Currency.Type}, {"ajuste", type text}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
