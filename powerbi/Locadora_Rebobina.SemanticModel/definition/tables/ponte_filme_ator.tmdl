/// Ponte entre filmes e atores (relação muitos-para-muitos).
table ponte_filme_ator
	lineageTag: 45de4589-32af-50a5-9115-72b2cfb60d50

	column id_filme
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 5e46ccea-5b52-5425-9b74-adad48a51e4e
		summarizeBy: none
		sourceColumn: id_filme

		annotation SummarizationSetBy = Automatic

	column id_ator
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: c94bea01-4432-51bb-9871-1ec7a97ee0e4
		summarizeBy: none
		sourceColumn: id_ator

		annotation SummarizationSetBy = Automatic

	column ordem_credito
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 2e754f28-f968-5f84-a93f-2a95f914079e
		summarizeBy: none
		sourceColumn: ordem_credito

		annotation SummarizationSetBy = Automatic

	partition ponte_filme_ator = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_filme", Int64.Type}, {"id_ator", Int64.Type}, {"ordem_credito", Int64.Type}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
