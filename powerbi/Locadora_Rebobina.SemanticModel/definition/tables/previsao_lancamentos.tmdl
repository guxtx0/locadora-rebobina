	partition previsao_lancamentos = m
		mode: import
		source =
				let
				    Partes = {
				        ""
				    },
				    Ler = (b64 as text) as table =>
				        Table.PromoteHeaders(
				            Csv.Document(
				                Binary.Decompress(Binary.FromText(b64, BinaryEncoding.Base64), Compression.Deflate),
				                [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				            ),
				            [PromoteAllScalars = true]
				        ),
				    Fonte = Table.Combine(List.Transform(Partes, Ler)),
				    Nulos = Table.TransformColumns(Fonte, {}, each if _ = "" then null else _),
				    Tipos = Table.TransformColumnTypes(Nulos, {{"id_filme", Int64.Type}, {"data_chegada", type date}, {"conjunto", type text}, {"demanda_real_8sem", type number}, {"demanda_prevista_8sem", type number}, {"erro_absoluto", type number}, {"copias_recomendadas_por_loja", type number}}, "en-US")
				in
				    Tipos

	annotation PBI_ResultType = Table
